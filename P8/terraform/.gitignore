# Proveedores descargados por terraform init: se vuelven a bajar solos.
.terraform/

# El state es la libreta de Terraform y puede guardar datos sensibles.
*.tfstate
*.tfstate.*

# Mis valores reales, como el correo. El formato esta en terraform.tfvars.example.
terraform.tfvars

# Planes guardados con -out: son binarios y pueden llevar valores sensibles.
*.tfplan
crash.log
